# Скопируйте в .env:  cp .env.example .env   — и поправьте значения. Секреты в репозиторий не коммитим.

# --- Администратор (единственный админ; управляется ТОЛЬКО отсюда, не через панель) ---
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-admin

# --- Безопасность ---
# минимум 16 символов; например: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# --- Единый часовой пояс системы (IANA). Определяет «сегодня» для сроков и просрочки ---
TZ=Europe/Moscow

# --- Telegram-бот ---
# 1) создайте бота у @BotFather и вставьте токен
# 2) на сайте в «Профиль и настройки» укажите свой @username и подтвердите в боте — напоминания о подписках придут лично
# 3) общий чат (общие платежи) — личный чат администратора после подтверждения или группа, где админ написал /start
#    TELEGRAM_CHAT_ID можно оставить пустым; если задать — он важнее привязки через бота
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
#    Если с сервера Telegram недоступен (бот пишет «нет связи с Telegram»): укажите прокси
#    TELEGRAM_PROXY=socks5://host:1080  или  http://host:3128  (или зеркало Bot API в TELEGRAM_API_ENDPOINT)
TELEGRAM_PROXY=
TELEGRAM_API_ENDPOINT=
REMINDER_STAGES=7,3,1
CHECK_INTERVAL=1m

# --- Регистрация: true — на экране входа можно создать аккаунт (только роль user); false — аккаунты создаёт админ ---
ALLOW_REGISTRATION=true

# --- Тестовые данные: аренда (RUB), сервер (USD), подписка (EUR) + пользователь user / user123 ---
# Создаются один раз, только в пустой базе
SEED_DEMO=true

# --- PostgreSQL ---
POSTGRES_USER=invoice
POSTGRES_PASSWORD=invoice
POSTGRES_DB=invoice

# --- Порты на хосте ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
# --- HTTPS и Telegram Mini App (кнопка «Приложение» в боте открывает сайт прямо в Telegram) ---
# Telegram открывает приложения только по https. Домен покупать не нужно: sslip.io сам указывает на IP сервера.
# 1) SITE_DOMAIN=138-124-14-110.sslip.io (IP сервера через дефисы)   2) PUBLIC_URL=https://138-124-14-110.sslip.io
# 3) docker compose --profile https up -d   — Caddy получит сертификат Let's Encrypt (нужны свободные порты 80 и 443)
SITE_DOMAIN=

# --- Машина времени для демо: администратор перематывает дату (кнопка внизу слева). false — выключить ---
DEMO_TIME_TRAVEL=true

# 127.0.0.1 — порт API доступен только с самого сервера (рекомендуется для боевого сервера);
# сайт ходит в API через свой nginx, поэтому всё продолжит работать. 0.0.0.0 — API открыт наружу.
BACKEND_BIND=0.0.0.0

# =====================  Дополнительные функции (всё необязательно)  =====================

# --- Почта администратора (для email-напоминаний админу) ---
ADMIN_EMAIL=

# --- Почта (SMTP): напоминания, «Оплачено», решения по чекам, коды подтверждения при регистрации ---
# Проще подключить прямо на сайте: «Профиль и настройки» → «Почта для уведомлений» (Яндекс, Mail.ru, Gmail) —
# без правки .env и перезапуска. Если заполнить здесь — .env важнее, а форма на сайте блокируется.
# Пример для Яндекса: SMTP_HOST=smtp.yandex.ru SMTP_PORT=465 SMTP_USER=you@yandex.ru SMTP_PASSWORD=<пароль приложения>
# Порт 465 — TLS сразу, 587 — STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Код подтверждения почты при регистрации: auto — если почта подключена (по умолчанию), true — всегда, false — без кода
EMAIL_VERIFY=auto
# адрес веб-панели для кнопки в письме
PUBLIC_URL=http://localhost:3000

# --- Webhook: POST с JSON на событиях (можно задать и в панели: Настройки → Интеграции; .env важнее) ---
WEBHOOK_URL=
# если задан — тело подписывается HMAC-SHA256, заголовок X-InvoiceKeeper-Signature: sha256=<hex>
WEBHOOK_SECRET=

# --- Проверка оплат по чекам ---
# Режим (чек + автопроверка / только администратор / без чека) выбирается в панели: «Профиль и настройки» → «Проверка оплат».
# Распознавание работает без ключей: QR кассового чека, текст PDF из банка и OCR фото (Tesseract, встроен в Docker-образ).
# Необязательно — ИИ-модель для фото и скриншотов (вторая проверка, замечания о подделке):
#   AI_PROVIDER=anthropic  AI_API_KEY=sk-ant-...           (Claude, модель по умолчанию claude-haiku-5-5)
#   AI_PROVIDER=openai     AI_API_KEY=...  AI_BASE_URL=https://api.openai.com/v1  AI_MODEL=gpt-4o-mini
#   (любой OpenAI-совместимый API: OpenRouter, локальная Ollama — AI_BASE_URL=http://host:11434/v1, AI_MODEL=qwen2.5vl)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
OCR_LANGS=rus+eng
# Тестовая версия в интернете: true — в окне «Приложить чек» появляются образцы чеков для скачивания (банк не нужен).
DEMO_MODE=false

# --- Telegram: true — кнопку «Оплачено» нажимают только пользователи сайта, подтвердившие свой @username
# (Настройки → «Ваш Telegram» → «Да, это я» в боте). false — может любой участник чата напоминаний.
TELEGRAM_REQUIRE_LINK=true
# Рабочий адрес api.telegram.org, если часть адресов Telegram заблокирована на хостинге (по умолчанию 149.154.167.220)
TELEGRAM_IP=149.154.167.220
